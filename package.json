{
  "name": "ferddo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ferddo — Starter SaaS multi-tenant: React + Vite + Tailwind + Supabase (RLS, planes, super-admin, PWA offline).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "test": "node --test src/lib/*.test.ts",
    "test:db": "supabase db query --linked -f supabase/tests/erp_integration.sql; supabase db query --linked -f supabase/tests/phase8_integration.sql; supabase db query --linked -f supabase/tests/phase9_integration.sql",
    "icons": "node scripts/generate-icons.mjs",
    "rename": "node scripts/rename.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "types:gen": "supabase gen types typescript --local > src/types/supabase.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/query-sync-storage-persister": "^5.101.3",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-query-persist-client": "^5.101.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.28.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  },
  "engines": {
    "node": ">=20"
  }
}
